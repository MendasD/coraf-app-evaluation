# Copiez ce fichier en .env pour le dev local. Toutes ces valeurs peuvent
# être surchargées par les variables d'environnement Railway en production.

# === Django ===
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines de confiance pour le CSRF (HTTPS, séparées par virgule)
# Exemple en prod : https://coraf-eval-production.up.railway.app
# CSRF_TRUSTED_ORIGINS=

# === Base de données ===
# EN PRODUCTION (Railway) : définissez UNIQUEMENT DATABASE_URL (Neon).
# Format : postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=

# EN DEV LOCAL : ne définissez PAS DATABASE_URL, ces variables sont utilisées :
POSTGRES_DB=coraf_eval
POSTGRES_USER=coraf
POSTGRES_PASSWORD=coraf
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
